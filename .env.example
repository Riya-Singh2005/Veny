# Copy to .env.local (git-ignored) and fill in.
# Only PUBLIC values belong here: the publishable key is safe in the browser ONLY because RLS is enforced.
# Never put the secret / service-role key or the database password in any VITE_ variable.

# Local stack (`supabase start`, then `supabase status`):
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_local_key

# Staging: https://<project-ref>.supabase.co and the project's sb_publishable_ key
